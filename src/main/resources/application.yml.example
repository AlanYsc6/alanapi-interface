# 复制为 application.yml 后填入真实值

spring:
  application:
    name: alanapi-interface
  # DataSource Config
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://<数据库地址>:3306/<库名>
    username: <数据库用户名>
    password: <数据库密码>
  # Redis Config（与 alanapi-backend 共用）
  redis:
    port: 6379
    host: <redis 地址>
    database: 0
    password: <redis 密码>

server:
  port: 8123
  servlet:
    context-path: /api

# SDK 测试凭证（user 表中注册用户的 accessKey / secretKey，供 AlanApiClientTest 使用）
sdk:
  access-key: <accessKey>
  secret-key: <secretKey>

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: false
  global-config:
    db-config:
      logic-delete-field: isDelete # 全局逻辑删除的实体字段名
      logic-delete-value: 1 # 逻辑已删除值(默认为 1)
      logic-not-delete-value: 0 # 逻辑未删除值(默认为 0)
